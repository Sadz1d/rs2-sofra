# ===== Sofra — konfiguracija (kopiraj u .env i popuni; .env se NIKAD ne commit-a) =====
ASPNETCORE_ENVIRONMENT=Development

# SQL Server
SQL_DATABASE=230074
SQL_SA_PASSWORD=Sofra_2026!Strong
SQL_PORT=1433
# lokalno (van Dockera) API koristi ovaj string; u compose-u se override-a na host "sqlserver"
ConnectionStrings__Default=Server=localhost,1433;Database=230074;User Id=sa;Password=Sofra_2026!Strong;TrustServerCertificate=True;Encrypt=False

# API
API_PORT=5000
Api__BaseUrl=http://localhost:5000
Cors__AllowedOrigins=http://localhost:5000

# JWT
Jwt__Issuer=Sofra.API
Jwt__Audience=Sofra.Clients
Jwt__Key=promijeni-me-najmanje-64-znaka-nasumicnog-teksta-za-hmac-sha256-potpis-tokena
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# RabbitMQ
RABBITMQ_USER=sofra
RABBITMQ_PASSWORD=sofra
RABBITMQ_PORT=5672
RabbitMq__Host=localhost
RabbitMq__Port=5672
RabbitMq__Username=sofra
RabbitMq__Password=sofra
RabbitMq__Exchange=sofra.events

# SMTP (npr. Mailtrap / Gmail app password / Ethereal)
Smtp__Host=sandbox.smtp.mailtrap.io
Smtp__Port=2525
Smtp__Username=
Smtp__Password=
Smtp__UseSsl=false
Smtp__FromAddress=noreply@sofra.ba
Smtp__FromName=Sofra

# Stripe (sandbox / test mode)
Stripe__SecretKey=sk_test_xxx
Stripe__PublishableKey=pk_test_xxx
Stripe__WebhookSecret=whsec_xxx
Stripe__Currency=bam

# Recommender
Recommender__RecalculateAtUtc=03:00
Recommender__ProfileCacheMinutes=10

# Narudzbe
Order__TaxRatePercent=17

# Restoran / rezervacije
Restaurant__OpenTime=08:00:00
Restaurant__CloseTime=23:00:00
Reservation__SlotIntervalMinutes=30
Reservation__UpcomingWindowMinutes=30

# Seed
Seed__DefaultPassword=test
